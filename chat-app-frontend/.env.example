# Optional. Where `npm run dev` proxies /api, /uploads and the websocket (default http://localhost:5000).
VITE_API_PROXY=http://localhost:5000

# Optional. Only when the built app is hosted on a different domain than the API.
# The API then needs this site's origin in CORS_ORIGIN.
# VITE_API_URL=https://api.example.com
