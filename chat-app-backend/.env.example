# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=5000

# Local MongoDB or an Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/voxella

# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN_DAYS=7

# Optional. Without Cloudinary, uploaded images are stored in ./uploads and served at /uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional. Only needed when the frontend is hosted on a different domain than the API.
CORS_ORIGIN=
